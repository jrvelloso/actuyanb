# Normalize every text checkout to LF. This keeps formatter results stable on
# Windows while the explicit .bat and binary rules below retain their formats.
* text=auto eol=lf

# Keep these explicit rules as documentation for source and script formats
# that must remain LF even if the default policy changes later.
# *.c text
# *.h text

# Declare files that will always have LF line endings on checkout.
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.tsx text eol=lf

**/bin/* text eol=lf

yarn.lock text eol=lf

# Declare files that will always have CRLF line endings on checkout.
packages/mobile-client/android/gradlew.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
packages/loot-core/src/mocks/files/utf-16*.csv binary
