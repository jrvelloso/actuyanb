# Copy this file to .env.local and replace <windows-user>.
# This local-only override keeps the durable data directory outside the checkout.
ACTUYNAB_DATA_DIR=C:/Users/<windows-user>/AppData/Local/ActuYNAB/local-sync-data
ACTUYNAB_LOCAL_PORT=5006

# Required while Compose resolves the base Caddy service. The local override
# does not start Caddy and does not obtain a certificate.
ACTUYNAB_SYNC_HOST=localhost
ACTUYNAB_TLS_EMAIL=local-only@example.invalid
