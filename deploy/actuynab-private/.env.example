# A DNS name that resolves to this host. Caddy obtains a publicly trusted
# certificate only when ports 80 and 443 are reachable and this name resolves.
ACTUYNAB_SYNC_HOST=sync.example.invalid
ACTUYNAB_TLS_EMAIL=operator@example.invalid

# Absolute host path for the durable Actual sync-server data directory.
# The container runs as UID/GID 1001, so this directory must be writable by it.
ACTUYNAB_DATA_DIR=/srv/actuynab/data
